# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=7584736341

# Solana RPC & Data Providers
# Dapatkan API Key gratis di https://dashboard.helius.dev/
HELIUS_API_KEY=
# Solana RPC URL (Default public atau RPC Helius)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Trading Settings
# Set true untuk simulasi $0 risiko (Akun Dummy), set false untuk live trading
PAPER_TRADING=true
INITIAL_PAPER_BALANCE_SOL=10.0
DEFAULT_BUY_AMOUNT_SOL=0.1
SLIPPAGE_PCT=1.5

# Risk Management
TAKE_PROFIT_PCT=50.0
STOP_LOSS_PCT=20.0
TRAILING_STOP_PCT=15.0

# Anti-Rug Filters (RugCheck)
# Minimum score (0 - 100). 80+ direkomendasikan untuk koin aman
MIN_RUGCHECK_SCORE=75
REQUIRE_MINT_REVOKED=true
REQUIRE_FREEZE_REVOKED=true
REQUIRE_LP_BURNED=true
MAX_TOP10_HOLDERS_PCT=30.0

# Polling interval (detik) untuk memantau harga posisi aktif
POSITION_CHECK_INTERVAL_SEC=10
WHALE_CHECK_INTERVAL_SEC=15
